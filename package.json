{
  "name": "corewiselearn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser game hub for 4 and 5 year olds. Vanilla TypeScript, Canvas 2D, Vite, installable PWA.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-voice.mjs && vite build && node scripts/check-precache.mjs",
    "check:precache": "node scripts/check-precache.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
